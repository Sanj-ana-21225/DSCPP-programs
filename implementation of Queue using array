#include<iostream>
using namespace std;

#define MAX 5
class Queue{
	int arr[MAX];
	int front,rear;
	
	public:
		queue(){
			front=-1;
			rear=-1;
		}
		
		void enqueue(int x){
			if (rear== MAX-1){
				cout<<"queue overflow\n";
			}
			else{
			if(front==-1)
			front=0;
			
				rear++;
				arr[rear]=x;
				cout<<x<<"inserted\n";
			
		}
	}
			void dequeue(){
				if(front==-1||front>rear){
					cout<<"queue underflow\n";
				}
				else{
				cout<<arr[front]<<"deleted\n";
				front++;
			}
		}
			
			void display(){
				if(front==-1 || front>rear){
					cout<<"queue is empty\n";
				
				}
				cout<<"queue elements: ";
				for(int i=front; i<=rear;i++){
					cout<<arr[i]<<" ";
				}
					cout<<endl;
			}
			
};

int main(){
	Queue q;
	
	q.enqueue(15);
	q.enqueue(25);
	q.enqueue(35);
	
	q.display();
	
	q.dequeue();
	q.display();
	
	
	return 0;
}
