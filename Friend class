#include <iostream>
using namespace std;

class AccountManager;   // Forward declaration

class BankAccount
{
private:
    float balance;

public:
    BankAccount()
    {
        balance = 0;
    }

    friend class AccountManager;   // Friend class declaration
};

class AccountManager
{
public:
    void deposit(BankAccount &acc, float amount)
    {
        acc.balance = acc.balance + amount;
        cout << "Deposited: " << amount << endl;
    }

    void withdraw(BankAccount &acc, float amount)
    {
        if(amount <= acc.balance)
        {
            acc.balance = acc.balance - amount;
            cout << "Withdrawn: " << amount << endl;
        }
        else
        {
            cout << "Insufficient Balance" << endl;
        }
    }

    void display(BankAccount &acc)
    {
        cout << "Current Balance: " << acc.balance << endl;
    }
};

int main()
{
    BankAccount b;
    AccountManager m;

    m.deposit(b, 5000);
    m.withdraw(b, 2000);
    m.display(b);

    return 0;
}
