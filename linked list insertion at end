#include<iostream>
using namespace std;

struct Node{
	int data;
	Node* next;
};
 Node* head = NULL;
 
 void insertAtEnd(int val){
 	Node*newNode = new Node();
 	newNode->data=val;
 	newNode->next=NULL;
    
    if(head==NULL){
    	head=newNode;
    	return;
	}
	Node*temp=head;
	while(temp->next!=NULL)
	temp=temp->next;
	
	temp->next=newNode;
 }
 void display(){
 Node*temp=head;
 while(temp!=NULL){
 	cout<<temp->data<<"->";
 	temp=temp->next;
 }
 cout<<"NULL";
}
 int main()
 {
 int n,x;
 cout<<"enter no. of nodes:";
 cin>>n;

 for(int i=0;i<n;i++){
	cout<<"enter value";
	cin>>x;
	insertAtEnd(x);
}
 cout<<"linked list:";
display();

return 0;
}
