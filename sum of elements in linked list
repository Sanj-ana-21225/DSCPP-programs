#include<iostream>
using namespace std;

struct Node{
	int data;
	Node* next;
	
};
    Node*head= NULL;
    
    void insertbegin(int val){
    	Node*newNode=new Node;
    	newNode->data=val;
    	newNode->next=head;
        head=newNode;
	}
    
   int sumofele(int x){
	Node* temp=head;
	int sum=0;
	
	while(temp!=NULL){
		sum=sum+temp->data;
		temp=temp->next;
	}
	return sum;	
}
int main()
{
	int n,x;
	cout<<"enter no. of nodes:";
	cin>>n;
	
	for(int i=0;i<n;i++){
		cout<<"enter value";
         cin>>x;
         insertbegin (x);
		
        sumofele(x);
	}
	cout<<"sum="<<sumofele(x);
	
	return 0;
}
