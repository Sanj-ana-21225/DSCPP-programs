#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* prev;
    Node* next;
};

void insertEnd(Node*& head, int x) {
    Node* newNode = new Node{x, NULL, NULL};

    if (head == NULL) {
        newNode->next = newNode;
        newNode->prev = newNode;
        head = newNode;
    }
    else {
        Node* last = head->prev;

        last->next = newNode;
        newNode->prev = last;

        newNode->next = head;
        head->prev = newNode;
    }
}

void createFromArray(Node*& head, int arr[], int n) {
    for (int i = 0; i < n; i++) {
        insertEnd(head, arr[i]);
    }
}
void display(Node* head) {
    if (head == NULL) return;

    Node* temp = head;
    do {
        cout << temp->data << " ";
        temp = temp->next;
    } while (temp != head);
}

int main() {
    Node* head = NULL;
    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    int arr[n];
    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

   createFromArray(head, arr, n);

    cout << "Doubly Circular Linked List: ";
    display(head);

    return 0;
}
