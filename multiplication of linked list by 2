#include<iostream>
using namespace std;

struct Node{
	int data;
	Node* next;
};
   Node*head= NULL;
   
   void insert(int val){
   	Node*newNode=new Node();
   	newNode->data=val;
   	newNode->next=head;
   	head=newNode;
   }
    void multiply(){
    	Node*temp=head;
    	
    	while(temp!=NULL){
    		temp->data=temp->data*2;
    		temp=temp->next;
		}
	}
	   void display(){
	   	Node*temp=head;
	   	
	   	while(temp!=NULL){
	   		cout<<temp->data<<"->";
	   		temp=temp->next;
		   }
	   }
	int main()
	{
		int n,x;
		cout<<"enter no. of nodes:";
		cin>>n;
		
		for(int i=0;i<n;i++){
			cin>>x;
			insert(x);
		}
		multiply();
		
		cout<<"After multiplying:";
		display();
		return 0;
	}
