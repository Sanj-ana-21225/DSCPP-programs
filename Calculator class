#include <iostream>
using namespace std;

class Calculator
{
private:
    float num1, num2;

public:
    void getNumbers()
    {
        cout << "Enter two numbers: ";
        cin >> num1 >> num2;
    }

    void addition()
    {
        cout << "Addition = " << num1 + num2 << endl;
    }

    void subtraction()
    {
        cout << "Subtraction = " << num1 - num2 << endl;
    }

    void multiplication()
    {
        cout << "Multiplication = " << num1 * num2 << endl;
    }

    void division()
    {
        if(num2 != 0)
            cout << "Division = " << num1 / num2 << endl;
        else
            cout << "Division not possible (divide by zero)" << endl;
    }
};

int main()
{
    Calculator c;

    c.getNumbers();
    c.addition();
    c.subtraction();
    c.multiplication();
    c.division();

    return 0;
}
